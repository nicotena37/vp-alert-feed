040","A060"],"p":[]},{"e":"37","a":["A053","A060"],"p":["P151"]},{"e":"38","a":["A059","A060"],"p":[]},{"e":"39","a":["A060","A059"],"p":[]},{"e":"40","a":[],"p":[],"na":"Obblighi di altri soggetti"},{"e":"41","a":[],"p":[],"na":"Disposizioni finali"},{"e":"42","a":[],"p":[],"na":"Disposizioni finali"},{"e":"43","a":[],"p":[],"na":"Obblighi di altri soggetti"},{"e":"44","a":[],"p":[],"na":"Disposizioni finali"}],"nota":"Testo letto integralmente (2098 righe). Articoli 7, 9 e 10 indicati come abrogati nel testo; art. 17 classificato Abrogato perche il testo riporta l'abrogazione con decorrenza legata alle norme attuative del TUB titolo VI-bis (aggiornamento nota 8), verificare la data effettiva. Parti 29-bis, 29-ter, 29-quater e 29-quinquies racchiuse tra doppie parentesi ((...)) senza nota di abrogazione: vigenza non verificata, classificate come Obblighi di altri soggetti (CONSOB, Banca d'Italia). Deleghe al Governo (parti 12, 27, 40, 43) classificate come Obblighi di altri soggetti. Le note di riferimento che riportano testi di altre leggi sono state lette ma classificate in base alla disposizione operativa. Rubriche di alcune parti spezzate su piu righe. Nessun ambito nuovo proposto."}
